{
  "expo": {
    "name": "expo-test",
    "slug": "expo-test",
    "entryPoint": "./index.js",
    "scheme": "solari-expo-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-asset",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.solari.test",
          "enableGooglePay": false
        }
      ]
    ]
  }
}
