# Axum server port
AXUM_PORT=3001

# Vipps test credentials
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# Apple Pay credentials/config
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_DISPLAY_NAME=
APPLE_PAY_INITIATIVE=web
APPLE_PAY_INITIATIVE_CONTEXT=
APPLE_PAY_MERCHANT_VALIDATION_URL=
APPLE_PAY_PAYMENT_PROCESSING_CERT_PEM=
APPLE_PAY_PAYMENT_PROCESSING_KEY_PEM=

# Optional: start ngrok automatically when the server starts
NGROK_ENABLED=true

# Optional: reserved ngrok public URL for a stable URL (recommended for mobile redirect/callback testing)
# Example: NGROK_DOMAIN=https://my-solari-dev.ngrok-free.app
NGROK_DOMAIN=

# Optional: ngrok authtoken if ngrok is not already configured locally
NGROK_AUTHTOKEN=

# When NGROK_DOMAIN is set, the public webhook URL becomes:
# <NGROK_DOMAIN>/webhook/vipps
